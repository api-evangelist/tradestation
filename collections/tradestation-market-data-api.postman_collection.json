        {
          "id": "43dd08fa-935d-40a9-a224-52b6817a0c5a",
          "name": "Get bar chart data",
          "request": {
            "name": "Get bar chart data",
            "description": {
              "content": "Retrieves historical bar chart data (OHLC) for a given symbol. Supports multiple intervals and units including minute, daily, weekly, and monthly bars. Returns open, high, low, close prices along with volume and timestamp information.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "marketdata",
                "barcharts",
                ":symbol"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "interval",
                  "value": "<integer>",
                  "description": "The interval for each bar. For minute bars, valid values are 1-1440. For daily, weekly, and monthly bars, use 1."
                },
                {
                  "disabled": false,
                  "key": "unit",
                  "value": "<string>",
                  "description": "The unit of time for the bar interval."
                },
                {
                  "disabled": false,
                  "key": "barsBack",
                  "value": "<integer>",
                  "description": "Number of bars to retrieve going back from the last date."
                },
                {
                  "disabled": false,
                  "key": "firstDate",
                  "value": "<dateTime>",
                  "description": "The start date for bar data retrieval."
                },
                {
                  "disabled": false,
                  "key": "lastDate",
                  "value": "<dateTime>",
                  "description": "The end date for bar data retrieval."
                },
                {
                  "disabled": false,
                  "key": "sessionTemplate",
                  "value": "<string>",
                  "description": "The session template to use for filtering bar data. Controls which trading session data to include."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "symbol",
                  "description": "(Required) The symbol to retrieve bar chart data for."
